{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mindhunt",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Everything else is a static file and never runs the Worker (free, unmetered).
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  // The free plan only offers SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }],
  "observability": { "enabled": true },
  // Same variables as the Go server (README "Configuration"). Secrets such as
  // DAILY_KEY and ADMIN_TOKEN are set with `npx wrangler secret put NAME`.
  "vars": {
    "APP_NAME": "MindHunt",
    // The web client is also on Vercel; it calls this Worker cross-origin.
    "ALLOWED_ORIGINS": "mindhunt-seven.vercel.app",
    "PUBLIC_URL": "https://mindhunt-seven.vercel.app"
  }
}
