{
  "id": "chemical-elements",
  "version": 2,
  "as_of": "2026-10-18",
  "category": "Science",
  "title": "Chemical Elements",
  "noun": "element",
  "description": "Fifty-two elements from hydrogen to plutonium.",
  "draft": false,
  "notes": "Hand-entered; verify every row before a public release.",
  "attributes": [
    {
      "key": "atomic_number",
      "label": "Atomic number",
      "type": "int",
      "min": 1,
      "max": 118,
      "step": 1,
      "templates": {
        "eq": "Is its atomic number {value}?",
        "gt": "Is its atomic number more than {value}?",
        "lt": "Is its atomic number less than {value}?",
        "between": "Is its atomic number between {value} and {value2}?"
      }
    },
    {
      "key": "period",
      "label": "Period",
      "type": "int",
      "min": 1,
      "max": 7,
      "step": 1,
      "help": "The row of the periodic table.",
      "templates": {
        "eq": "Is it in period {value}?",
        "gt": "Is it below period {value}?",
        "lt": "Is it above period {value}?",
        "between": "Is it in periods {value} to {value2}?"
      }
    },
    {
      "key": "block",
      "label": "Block",
      "type": "enum",
      "values": [
        "s",
        "p",
        "d",
        "f"
      ],
      "templates": {
        "eq": "Is it in the {value}-block?"
      }
    },
    {
      "key": "category",
      "label": "Category",
      "type": "enum",
      "values": [
        "Alkali metal",
        "Alkaline earth metal",
        "Transition metal",
        "Post-transition metal",
        "Metalloid",
        "Other nonmetal",
        "Halogen",
        "Noble gas",
        "Lanthanide",
        "Actinide"
      ],
      "help": "Common textbook grouping. Zinc and mercury count as transition metals (IUPAC 2011). 'Other nonmetal' means hydrogen, carbon, nitrogen, oxygen, phosphorus and sulfur. Polonium is Unknown because sources disagree.",
      "templates": {
        "eq": "Is it a {value_lc}?",
        "eq:Other nonmetal": "Is it a nonmetal that isn't a halogen or noble gas?"
      },
      "aliases": {
        "Noble gas": [
          "inert gas"
        ],
        "Transition metal": [
          "transition element"
        ],
        "Other nonmetal": [
          "nonmetal",
          "non metal",
          "reactive nonmetal"
        ],
        "Alkali metal": [
          "alkali"
        ],
        "Alkaline earth metal": [
          "alkaline earth"
        ]
      }
    },
    {
      "key": "state",
      "label": "State at room temperature",
      "type": "enum",
      "values": [
        "Solid",
        "Liquid",
        "Gas"
      ],
      "help": "At 25 °C and normal pressure.",
      "templates": {
        "eq": "Is it a {value_lc} at room temperature?"
      },
      "aliases": {
        "Gas": [
          "gaseous"
        ]
      }
    },
    {
      "key": "radioactive",
      "label": "Radioactive",
      "type": "bool",
      "help": "Has no stable isotopes.",
      "templates": {
        "is": "Is it radioactive?",
        "is_false": "Does it have a stable isotope?"
      }
    },
    {
      "key": "ancient",
      "label": "Known since ancient times",
      "type": "bool",
      "help": "The nine classical elements: carbon, sulfur, iron, copper, silver, tin, gold, mercury, lead. Antimony, zinc, arsenic and platinum were used in antiquity but recognised as elements later, so they answer Unknown.",
      "templates": {
        "is": "Was it known in ancient times?",
        "is_false": "Was it discovered in modern times?"
      }
    },
    {
      "key": "odd_symbol",
      "label": "Symbol not from its English name",
      "type": "bool",
      "help": "Symbols from Latin or German names, like Fe for iron or W for tungsten.",
      "templates": {
        "is": "Does its symbol come from a non-English name?",
        "is_false": "Does its symbol come from its English name?"
      }
    },
    {
      "key": "letters",
      "label": "Name",
      "type": "string",
      "help": "Ask about the first 1 to 3 letters (spaces and hyphens ignored).",
      "templates": {
        "starts_with": "Does the element's name start with “{value}”?"
      }
    }
  ],
