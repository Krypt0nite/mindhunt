{
  "id": "world-countries",
  "version": 2,
  "as_of": "2026-10-18",
  "category": "Geography",
  "title": "Countries",
  "noun": "country",
  "description": "Countries from every continent, with an India-first selection.",
  "draft": false,
  "notes": "Hand-entered; verify every row before a public release.",
  "attributes": [
    {
      "key": "continent",
      "label": "Continent",
      "type": "set",
      "values": [
        "Asia",
        "Europe",
        "Africa",
        "North America",
        "South America",
        "Oceania"
      ],
      "help": "Countries whose land spans two continents (Russia, Turkey, Kazakhstan, Egypt) count for both; overseas islands don't.",
      "templates": {
        "contains": "Is it (at least partly) in {value}?"
      },
      "aliases": {
        "Asia": [
          "asian"
        ],
        "Europe": [
          "european"
        ],
        "Africa": [
          "african"
        ],
        "North America": [
          "north american",
          "caribbean"
        ],
        "South America": [
          "south american",
          "latin america"
        ],
        "Oceania": [
          "pacific",
          "australasia"
        ]
      }
    },
    {
      "key": "landlocked",
      "label": "Landlocked",
      "type": "bool",
      "templates": {
        "is": "Is it landlocked?",
        "is_false": "Does it have a coastline?"
      }
    },
    {
      "key": "island",
      "label": "Island nation",
      "type": "bool",
      "help": "The whole country is on islands. Australia counts as a continent, not an island nation.",
      "templates": {
        "is": "Is it an island nation?",
        "is_false": "Is it on a mainland?"
      }
    },
    {
      "key": "drives_left",
      "label": "Drives on the left",
      "type": "bool",
      "templates": {
        "is": "Do they drive on the left?",
        "is_false": "Do they drive on the right?"
      }
    },
    {
      "key": "g20",
      "label": "G20 member",
      "type": "bool",
      "help": "A member country of the G20 in its own right (the EU and African Union don't count here).",
      "templates": {
        "is": "Is it a G20 member?",
        "is_false": "Is it outside the G20?"
      }
    },
    {
      "key": "borders_india",
      "label": "Borders India",
      "type": "bool",
      "help": "Shares a land border with India. India itself is No.",
      "templates": {
        "is": "Does it share a land border with India?",
        "is_false": "Does it not border India?"
      }
    },
    {
      "key": "summer_olympics",
      "label": "Hosted the Summer Olympics",
      "type": "bool",
      "help": "Games held up to 2024. Moscow 1980 counts for Russia, Munich 1972 for Germany.",
      "templates": {
        "is": "Has it hosted the Summer Olympics?",
        "is_false": "Has it never hosted the Summer Olympics?"
      }
    },
    {
      "key": "fifa_world_cup",
      "label": "Hosted the FIFA World Cup",
      "type": "bool",
      "help": "Men's FIFA World Cups held so far, including co-hosting (2002, 2026). England 1966 counts for the UK; future hosts (2030, 2034) don't yet.",
      "templates": {
        "is": "Has it hosted the men's FIFA World Cup?",
        "is_false": "Has it never hosted the FIFA World Cup?"
      }
    },
    {
      "key": "pop_100m",
      "label": "Over 100 million people",
      "type": "bool",
      "templates": {
        "is": "Does it have more than 100 million people?",
        "is_false": "Does it have fewer than 100 million people?"
      }
    },
    {
      "key": "monarchy",
      "label": "Monarch as head of state",
      "type": "bool",
      "help": "Includes Commonwealth realms whose head of state is the British monarch (Canada, Australia, New Zealand, Jamaica).",
      "templates": {
        "is": "Is its head of state a monarch?",
        "is_false": "Is it a republic?"
      }
    },
    {
      "key": "south",
      "label": "Mostly south of the equator",
      "type": "bool",
      "help": "Wholly or mostly south of the equator. Unknown for countries the equator splits roughly in half (Kenya).",
      "templates": {
        "is": "Is it mostly in the Southern Hemisphere?",
        "is_false": "Is it mostly in the Northern Hemisphere?"
      }
    },
    {
      "key": "letters",
      "label": "Name",
      "type": "string",
      "help": "Ask about the first 1 to 3 letters (spaces and hyphens ignored).",
      "templates": {
        "starts_with": "Does the country's name start with “{value}”?"
      }
    }
  ],
