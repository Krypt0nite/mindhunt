        "is": "Have they captained their country?",
        "is_false": "Have they never captained their country?"
      }
    },
    {
      "key": "odi_wc_winner",
      "label": "ODI World Cup winner",
      "type": "bool",
      "help": "Member of a squad that won the men's 50-over World Cup.",
